# Non-secret Compose settings only. Copy to .env and choose deployment-specific values.
FOLIOHARBOR_IMAGE=ghcr.io/folioharbor/folioharbor:0.1.0
FOLIOHARBOR_PUBLIC_BASE_URL=https://library.example/
FOLIOHARBOR_HTTP_BIND=127.0.0.1:8080
FOLIOHARBOR_UID=10001
FOLIOHARBOR_GID=10001
FOLIOHARBOR_WORKER_CONCURRENCY=1
FOLIOHARBOR_STORAGE_FREE_RESERVE_BYTES=1073741824
FOLIOHARBOR_APPLICATION_SECRET_KEY_ID=primary-2026
FOLIOHARBOR_MAIL_SMTP_URL=smtp://mailpit:1025
FOLIOHARBOR_MAIL_FROM_ADDRESS=noreply@library.example
FOLIOHARBOR_LOG_FILTER=info

# Optional OTLP/gRPC collector. Leave unset to disable exporting.
# FOLIOHARBOR_OTLP_ENDPOINT=http://otel-collector:4317

# Each value below is a path, never the secret itself.
FOLIOHARBOR_POSTGRES_PASSWORD_FILE=./secrets/postgres-password
FOLIOHARBOR_OWNER_PASSWORD_FILE=./secrets/owner-password
FOLIOHARBOR_API_PASSWORD_FILE=./secrets/api-password
FOLIOHARBOR_WORKER_PASSWORD_FILE=./secrets/worker-password
FOLIOHARBOR_OWNER_DATABASE_URL_FILE=./secrets/owner-database-url
FOLIOHARBOR_API_DATABASE_URL_FILE=./secrets/api-database-url
FOLIOHARBOR_WORKER_DATABASE_URL_FILE=./secrets/worker-database-url
FOLIOHARBOR_APPLICATION_SECRET_FILE=./secrets/application-secret
